# Synthetic local credentials for the Docker Compose Postgres. Not a production secret.
DATABASE_URL=postgresql+psycopg://supportdesk:supportdesk@localhost:5433/supportdesk
CORPUS_DIR=data/corpus

# BAAI/bge-small-en-v1.5 is 384 dimensions. The chunks.embedding column matches this.
# The revision is a Hub commit. A branch name such as main is rejected.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a

# cross-encoder/ms-marco-MiniLM-L6-v2. Scores are raw logits. The revision is a Hub commit.
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANK_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a
EMBEDDING_DIMENSIONS=384
CHUNK_TOKEN_BUDGET=400
CHUNK_OVERLAP_TOKENS=60

# The judge must be a different model id from the generator. Temperature stays at 0.
# A real generate calls client.models.list() first and refuses if either id is absent.
GENERATOR_MODEL=gemini-3.8-flash
JUDGE_MODEL=gemini-2.5-flash
JUDGE_TEMPERATURE=0
GENERATOR_TEMPERATURE=0
GEMINI_API_KEY=

# Local synthetic signing secret. The role is the token claim, not a field in the query.
JWT_SECRET=supportdesk-dev-secret

# Mock CRM. The support API calls this over HTTP. It does not read tickets from Postgres.
CRM_BASE_URL=http://localhost:8001
CRM_API_KEY=supportdesk-crm-dev
CRM_TIMEOUT_SECONDS=2
CRM_RETRY_ATTEMPTS=3
CRM_RETRY_BACKOFF_SECONDS=0.2
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BACKOFF_SECONDS=0.2
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RESET_SECONDS=30
